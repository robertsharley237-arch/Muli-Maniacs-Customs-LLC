  <!-- ========================================================
       ORDER MANAGEMENT PAGE
       ======================================================== -->

  <main
    id="main-content"
    class="orders-page"
  >
    <section
      class="orders-container"
      aria-labelledby="orders-heading"
    >
      <div
        class="admin-tie-dye-color-bar"
        aria-hidden="true"
      ></div>

      <p class="admin-section-eyebrow">
        Order Management
      </p>

      <h1
        id="orders-heading"
        class="page-heading"
      >
        Client Orders
      </h1>

      <p class="page-description">
        Review Stripe orders, client contact information,
        purchased products, order totals, payment status, and
        order progress.
      </p>

      <!-- ====================================================
           ADMINISTRATOR ACCOUNT
           ==================================================== -->

      <div class="admin-account-bar">
        <div>
          <p>
            Signed in as:

            <strong id="admin-username">
              Loading...
            </strong>
          </p>

          <p>
            Role:

            <strong id="admin-role">
              Loading...
            </strong>
          </p>
        </div>

        <div class="admin-account-actions">
          <a
            class="small-action-button"
            href="admin-dashboard.html"
          >
            Dashboard
          </a>

          <a
            class="small-action-button"
            href="admin-inventory.html"
          >
            Inventory
          </a>

          <button
            id="admin-logout-button"
            class="small-action-button logout-action-button"
            type="button"
          >
            Log Out
          </button>
        </div>
      </div>

      <!-- ====================================================
           SEARCH AND FILTER CONTROLS
           ==================================================== -->

      <section
        class="orders-toolbar"
        aria-label="Order search and filters"
      >
        <div class="toolbar-field">
          <label for="order-search">
            Search Orders
          </label>

          <input
            id="order-search"
            type="search"
            autocomplete="off"
            placeholder="Search by order ID, client, email, or product"
          >
        </div>

        <div class="toolbar-field">
          <label for="order-status-filter">
            Order Status
          </label>

          <select id="order-status-filter">
            <option value="all">
              All Statuses
            </option>

            <option value="pending">
              Pending
            </option>

            <option value="paid">
              Paid
            </option>

            <option value="processing">
              Processing
            </option>

            <option value="completed">
              Completed
            </option>

            <option value="cancelled">
              Cancelled
            </option>

            <option value="refunded">
              Refunded
            </option>
          </select>
        </div>

        <button
          id="refresh-orders-button"
          class="refresh-orders-button"
          type="button"
        >
          Refresh Orders
        </button>
      </section>

      <!-- ====================================================
           ORDER SUMMARY
           ==================================================== -->

      <section
        class="orders-summary"
        aria-label="Order summary"
      >
        <article class="summary-card">
          <h2>
            Total Orders
          </h2>

          <p
            id="total-orders"
            class="summary-number"
          >
            0
          </p>
        </article>

        <article class="summary-card">
          <h2>
            Pending
          </h2>

          <p
            id="pending-orders"
            class="summary-number"
          >
            0
          </p>
        </article>

        <article class="summary-card">
          <h2>
            Paid Orders
          </h2>

          <p
            id="paid-orders"
            class="summary-number"
          >
            0
          </p>
        </article>

        <article class="summary-card">
          <h2>
            Processing
          </h2>

          <p
            id="processing-orders"
            class="summary-number"
          >
            0
          </p>
        </article>

        <article class="summary-card">
          <h2>
            Completed
          </h2>

          <p
            id="completed-orders"
            class="summary-number"
          >
            0
          </p>
        </article>

        <article class="summary-card">
          <h2>
            Cancelled
          </h2>

          <p
            id="cancelled-orders"
            class="summary-number"
          >
            0
          </p>
        </article>

        <article class="summary-card">
          <h2>
            Refunded
          </h2>

          <p
            id="refunded-orders"
            class="summary-number"
          >
            0
          </p>
        </article>

        <article class="summary-card">
          <h2>
            Total Revenue
          </h2>

          <p
            id="total-order-revenue"
