  <style>
    /* ========================================================
       MULTI-MANIACS CUSTOMS LLC
       ADMINISTRATOR ORDER MANAGEMENT
       ======================================================== */

    .orders-page {
      width: calc(100% - 32px);
      max-width: 1400px;
      margin: 34px auto;
    }

    .orders-container {
      position: relative;
      overflow: hidden;
      padding: 30px;
      color: var(--admin-black, #000000);
      background:
        var(
          --admin-panel,
          rgba(255, 255, 255, 0.96)
        );
      border: 3px solid var(--admin-black, #000000);
      border-radius: 16px;
      box-shadow:
        0 14px 34px rgba(0, 0, 0, 0.38),
        0 0 0 4px rgba(255, 255, 255, 0.22);
    }

    .page-heading {
      margin: 0 0 10px;
      color: var(--admin-black, #000000);
      font-size: clamp(32px, 6vw, 46px);
      line-height: 1.15;
      text-align: center;
    }

    .page-description {
      max-width: 780px;
      margin: 0 auto 24px;
      color: var(--admin-muted, #333333);
      line-height: 1.65;
      text-align: center;
    }

    .admin-account-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 24px;
      padding: 16px;
      color: var(--admin-white, #ffffff);
      background: var(--admin-black, #000000);
      border: 3px solid var(--admin-black, #000000);
      border-radius: 10px;
    }

    .admin-account-bar p {
      margin: 4px 0;
      color: var(--admin-white, #ffffff);
    }

    .admin-account-bar strong {
      color: var(--admin-cyan, #00eaff);
    }

    .admin-account-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
    }

    .small-action-button {
      display: inline-flex;
      min-height: 42px;
      align-items: center;
      justify-content: center;
      padding: 9px 13px;
      color: var(--admin-white, #ffffff);
      background: var(--admin-dark-gray, #222222);
      border: 2px solid var(--admin-white, #ffffff);
      border-radius: 7px;
      font: inherit;
      font-size: 14px;
      font-weight: 800;
      line-height: 1.2;
      text-align: center;
      text-decoration: none;
      cursor: pointer;
      transition:
        color 0.2s ease,
        background 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .small-action-button:hover,
    .small-action-button:focus {
      color: var(--admin-black, #000000);
      background:
        linear-gradient(
          135deg,
          var(--admin-pink, #ff1493),
          var(--admin-yellow, #ffe600),
          var(--admin-green, #34e600),
          var(--admin-cyan, #00eaff)
        );
      transform: translateY(-2px);
      box-shadow:
        0 0 12px rgba(255, 20, 147, 0.42),
        0 0 16px rgba(0, 234, 255, 0.28);
    }

    .logout-action-button {
      color: var(--admin-white, #ffffff);
      background: var(--admin-red, #e53935);
    }

    .logout-action-button:hover,
    .logout-action-button:focus {
      color: var(--admin-white, #ffffff);
      background: #b71c1c;
    }

    .orders-toolbar {
      display: grid;
      grid-template-columns:
        minmax(220px, 1fr)
        minmax(180px, 240px)
        auto;
      gap: 14px;
      align-items: end;
      margin-bottom: 24px;
      padding: 20px;
      color: var(--admin-black, #000000);
      background: var(--admin-off-white, #fffdf8);
      border: 2px solid var(--admin-black, #000000);
      border-radius: 10px;
    }

    .toolbar-field {
      display: flex;
      min-width: 0;
      flex-direction: column;
      gap: 7px;
    }

    .toolbar-field label {
      color: var(--admin-black, #000000);
      font-size: 14px;
      font-weight: 800;
    }

    .toolbar-field input,
    .toolbar-field select {
      width: 100%;
      min-height: 46px;
      padding: 10px 11px;
      color: var(--admin-black, #000000);
      background: var(--admin-white, #ffffff);
      border: 2px solid var(--admin-black, #000000);
      border-radius: 8px;
      font: inherit;
    }

    .toolbar-field input:focus,
    .toolbar-field select:focus {
      outline: none;
      border-color: var(--admin-purple, #8a00ff);
      box-shadow:
        0 0 0 4px rgba(138, 0, 255, 0.2),
        0 0 12px rgba(0, 234, 255, 0.35);
    }

    .refresh-orders-button {
      display: inline-flex;
      min-height: 46px;
      align-items: center;
      justify-content: center;
      padding: 10px 15px;
      color: var(--admin-black, #000000);
      background:
        linear-gradient(
          135deg,
          var(--admin-yellow, #ffe600),
          var(--admin-cyan, #00eaff)
        );
      border: 2px solid var(--admin-black, #000000);
      border-radius: 8px;
      font: inherit;
      font-weight: 900;
      cursor: pointer;
      transition:
        filter 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .refresh-orders-button:hover:not(:disabled),
    .refresh-orders-button:focus:not(:disabled) {
      filter: saturate(1.2) brightness(1.05);
      transform: translateY(-2px);
      box-shadow:
        0 0 14px rgba(0, 234, 255, 0.4);
    }

    .refresh-orders-button:disabled {
      cursor: wait;
      filter: grayscale(0.6);
      opacity: 0.65;
      transform: none;
    }

    .orders-summary {
      display: grid;
      grid-template-columns:
        repeat(auto-fit, minmax(150px, 1fr));
      gap: 14px;
      margin-bottom: 24px;
    }

    .summary-card {
      position: relative;
      overflow: hidden;
      padding: 18px;
      color: var(--admin-black, #000000);
      background: var(--admin-white, #ffffff);
      border: 3px solid var(--admin-black, #000000);
      border-radius: 11px;
      text-align: center;
      box-shadow:
        0 8px 18px rgba(0, 0, 0, 0.2);
    }

    .summary-card::before {
      display: block;
      width: 100%;
      height: 7px;
      margin-bottom: 14px;
      background:
        linear-gradient(
          90deg,
          var(--admin-pink, #ff1493),
          var(--admin-purple, #8a00ff),
          var(--admin-cyan, #00eaff),
          var(--admin-green, #34e600),
          var(--admin-yellow, #ffe600)
        );
      border-radius: 999px;
      content: "";
    }

    .summary-card h2 {
      margin: 0 0 8px;
      color: var(--admin-muted, #333333);
      font-size: 15px;
      text-transform: uppercase;
    }

    .summary-number {
      margin: 0;
      color: var(--admin-black, #000000);
      font-size: 30px;
      font-weight: 900;
      line-height: 1.1;
    }

    .order-list {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .order-list-loading,
    .order-list-empty {
      padding: 30px 20px;
      color: var(--admin-muted, #333333);
      background: var(--admin-off-white, #fffdf8);
      border: 2px solid var(--admin-black, #000000);
      border-radius: 10px;
      line-height: 1.6;
      text-align: center;
    }

    .order-card {
      overflow: hidden;
      color: var(--admin-black, #000000);
      background: var(--admin-white, #ffffff);
      border: 3px solid var(--admin-black, #000000);
      border-radius: 12px;
      box-shadow:
        0 10px 24px rgba(0, 0, 0, 0.24);
    }

    .order-card-header {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      justify-content: space-between;
      gap: 14px;
      padding: 18px;
      background:
        linear-gradient(
          135deg,
          rgba(255, 20, 147, 0.1),
          rgba(255, 230, 0, 0.13),
          rgba(52, 230, 0, 0.1),
          rgba(0, 234, 255, 0.12)
        );
      border-bottom: 2px solid var(--admin-black, #000000);
    }

    .order-card-header h2 {
      margin: 0 0 7px;
      color: var(--admin-black, #000000);
      font-size: 21px;
      overflow-wrap: anywhere;
    }

    .order-date {
      margin: 0;
      color: var(--admin-muted, #333333);
      font-size: 14px;
    }

    .order-status {
      display: inline-flex;
      min-height: 32px;
      align-items: center;
      justify-content: center;
      padding: 6px 10px;
      color: #ffffff;
      background: #555555;
      border: 2px solid var(--admin-black, #000000);
      border-radius: 999px;
      font-size: 13px;
      font-weight: 800;
    }

    .status-pending {
      color: #000000;
      background: #ff9800;
    }

    .status-paid {
      color: #000000;
      background: #63d668;
    }

    .status-processing {
      background: #1565c0;
    }

    .status-completed {
      background: #23852b;
    }

    .status-cancelled,
    .status-refunded {
      background: #c40028;
    }

    .order-card-body {
      padding: 20px;
    }

    .order-information-grid {
      display: grid;
      grid-template-columns:
        repeat(auto-fit, minmax(190px, 1fr));
      gap: 14px;
    }

    .order-information-item {
      min-width: 0;
      padding: 14px;
      color: var(--admin-black, #000000);
      background: var(--admin-off-white, #fffdf8);
      border: 2px solid var(--admin-black, #000000);
      border-radius: 8px;
    }

    .order-information-item h3 {
      margin: 0 0 6px;
      color: var(--admin-muted, #333333);
      font-size: 13px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .order-information-item p {
      margin: 0;
      color: var(--admin-black, #000000);
      line-height: 1.55;
      overflow-wrap: anywhere;
    }

    .order-information-item a {
      color: #0053a6;
      font-weight: 800;
      overflow-wrap: anywhere;
    }

    .order-items-section {
      margin-top: 18px;
      padding: 16px;
      color: var(--admin-black, #000000);
      background: var(--admin-off-white, #fffdf8);
      border: 2px solid var(--admin-black, #000000);
      border-radius: 9px;
    }

    .order-items-section h3 {
      margin: 0 0 13px;
      color: var(--admin-black, #000000);
      font-size: 18px;
    }

    .order-items-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .order-item {
      display: grid;
      grid-template-columns:
        minmax(0, 1fr)
        auto;
      gap: 14px;
      padding: 13px;
      color: var(--admin-black, #000000);
      background: var(--admin-white, #ffffff);
      border: 2px solid var(--admin-black, #000000);
      border-radius: 8px;
    }

    .order-item h4 {
      margin: 0 0 6px;
      color: var(--admin-black, #000000);
      font-size: 16px;
      overflow-wrap: anywhere;
    }

    .order-item p {
      margin: 4px 0;
      color: var(--admin-muted, #333333);
      overflow-wrap: anywhere;
    }

    .order-item-total {
      color: var(--admin-black, #000000);
      font-weight: 900;
      white-space: nowrap;
    }

    .order-notes {
      margin-top: 18px;
      padding: 16px;
      color: var(--admin-black, #000000);
      background: var(--admin-off-white, #fffdf8);
      border: 2px solid var(--admin-black, #000000);
      border-radius: 9px;
    }

    .order-notes h3 {
      margin: 0 0 8px;
      font-size: 17px;
    }

    .order-notes p {
      margin: 0;
      line-height: 1.6;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    .order-card-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      padding: 18px 20px;
      background: var(--admin-off-white, #fffdf8);
      border-top: 2px solid var(--admin-black, #000000);
    }

    .order-card-actions label {
      color: var(--admin-black, #000000);
      font-weight: 800;
    }

    .order-card-actions select {
      min-height: 42px;
      padding: 9px 11px;
      color: var(--admin-black, #000000);
      background: var(--admin-white, #ffffff);
      border: 2px solid var(--admin-black, #000000);
      border-radius: 7px;
      font: inherit;
    }

    .order-action-button {
      display: inline-flex;
      min-height: 42px;
      align-items: center;
      justify-content: center;
      padding: 9px 13px;
      color: var(--admin-white, #ffffff);
      background: #1565c0;
      border: 2px solid var(--admin-black, #000000);
      border-radius: 7px;
      font: inherit;
      font-weight: 800;
      text-decoration: none;
      cursor: pointer;
      transition:
        background 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .order-action-button:hover:not(:disabled),
    .order-action-button:focus:not(:disabled) {
      background: #0d47a1;
      transform: translateY(-2px);
      box-shadow:
        0 0 12px rgba(21, 101, 192, 0.4);
    }

    .order-action-button:disabled {
      cursor: wait;
      filter: grayscale(0.6);
      opacity: 0.65;
      transform: none;
    }

    .orders-message {
      min-height: 24px;
      margin: 20px 0 0;
      padding: 0;
      border-radius: 9px;
      font-weight: 800;
      line-height: 1.5;
      text-align: center;
    }

    .orders-message:not(:empty) {
      padding: 12px 14px;
      border: 2px solid currentColor;
    }

    .orders-error {
      color: var(--admin-error-text, #b00024);
      background: #fff0f3;
    }

    .orders-success {
      color: var(--admin-success-text, #126b17);
      background: #effff2;
    }

    .orders-information {
      color: var(--admin-information-text, #003d9c);
      background: #edf8ff;
    }

    .page-actions {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-top: 24px;
    }

    @media (max-width: 900px) {
      .orders-toolbar {
        grid-template-columns: 1fr;
      }

      .refresh-orders-button {
        width: 100%;
      }
    }

    @media (max-width: 650px) {
      .orders-page {
        width: calc(100% - 24px);
        margin: 22px auto;
      }

      .orders-container {
        padding: 22px 14px;
      }

      .admin-account-bar {
        align-items: stretch;
        flex-direction: column;
      }

      .admin-account-actions,
      .page-actions,
      .order-card-actions {
        align-items: stretch;
        flex-direction: column;
      }

      .small-action-button,
      .page-actions a,
      .order-card-actions select,
      .order-action-button {
        width: 100%;
      }

      .order-item {
        grid-template-columns: 1fr;
      }

      .order-item-total {
        white-space: normal;
      }
    }
  </style>

